{
  "name": "gestor-estoque",
  "version": "1.0.0",
  "description": "Painel Administrativo de Estoque - MT Automações",
  "main": "main.js",
  "scripts": {
    "start": "node server/index.js",
    "electron": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-firebird": "^1.1.6"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mt.gestor-estoque",
    "productName": "Gestor Estoque",
    "copyright": "MT Automações",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**",
      "package.json",
      "node_modules/**",
      "Painel/**",
      "MTdll/**"
    ],
    "extraResources": [
      {
        "from": "MTdll/",
        "to": "MTdll/",
        "filter": ["**/*.dll", "**/*.DLL", "**/.gitkeep"]
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gestor Estoque"
    }
  }
}
